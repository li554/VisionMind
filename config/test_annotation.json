{
    "test_scenarios": [
        {
            "name": "01-项目导航",
            "description": "测试项目卡片点击、项目切换、界面导航",
            "enabled": false,
            "steps": [
                { "action": "wait", "duration": 3000, "description": "等待程序启动" },
                { "action": "click_project_card", "project_index": 0, "description": "点击第一个项目卡片" },
                { "action": "wait", "duration": 1500, "description": "等待项目加载" },
                { "action": "switch_project", "project_index": 0, "description": "通过Combo切换到第一个项目" },
                { "action": "wait", "duration": 500, "description": "等待项目切换" },
                { "action": "switch_to", "target": "dashboard", "description": "切换到项目大厅" },
                { "action": "wait", "duration": 500, "description": "等待界面切换" },
                { "action": "switch_to", "target": "annotation", "description": "切换回标注界面" },
                { "action": "wait", "duration": 500, "description": "等待界面切换" }
            ],
            "on_complete": { "action": "print_result", "message": "项目导航测试完成" }
        },
        {
            "name": "02-图片导航",
            "description": "测试图片选择、上一张/下一张、刷新",
            "enabled": false,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 1500, "description": "等待项目加载" },
                { "action": "select_image", "image_index": 0, "description": "选择第一张图片" },
                { "action": "wait", "duration": 500, "description": "等待图片加载" },
                { "action": "switch_image", "direction": 1, "description": "下一张图片" },
                { "action": "wait", "duration": 300, "description": "等待图片加载" },
                { "action": "switch_image", "direction": 1, "description": "下一张图片" },
                { "action": "wait", "duration": 300, "description": "等待图片加载" },
                { "action": "switch_image", "direction": -1, "description": "上一张图片" },
                { "action": "wait", "duration": 300, "description": "等待图片加载" },
                { "action": "annotation.refresh_files", "description": "刷新文件列表" },
                { "action": "wait", "duration": 500, "description": "等待刷新完成" }
            ],
            "on_complete": { "action": "print_result", "message": "图片导航测试完成" }
        },
        {
            "name": "03-类别管理",
            "description": "测试添加、选择、重命名、删除、导入导出类别",
            "enabled": false,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 1500, "description": "等待项目加载" },
                { "action": "add_category", "category_name": "测试类别A", "color": "#FF0000", "description": "添加类别A" },
                { "action": "wait", "duration": 300, "description": "等待类别添加" },
                { "action": "assert", "check": "lambda e: '测试类别A' in e.annotation_interface.categories", "message": "类别A应存在" },
                { "action": "add_category", "category_name": "测试类别B", "color": "#00FF00", "description": "添加类别B" },
                { "action": "wait", "duration": 300, "description": "等待类别添加" },
                { "action": "assert", "check": "lambda e: '测试类别B' in e.annotation_interface.categories", "message": "类别B应存在" },
                { "action": "select_category", "category_name": "测试类别A", "description": "选择类别A" },
                { "action": "wait", "duration": 200, "description": "等待类别选择" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.current_category == '测试类别A'", "message": "当前类别应为A" },
                { "action": "rename_category", "old_name": "测试类别A", "new_name": "重命名类别", "description": "重命名类别A" },
                { "action": "wait", "duration": 300, "description": "等待重命名" },
                { "action": "assert", "check": "lambda e: '测试类别A' not in e.annotation_interface.categories and '重命名类别' in e.annotation_interface.categories", "message": "旧名应消失，新名应存在" },
                { "action": "delete_category", "category_name": "重命名类别", "description": "删除重命名后的类别" },
                { "action": "wait", "duration": 300, "description": "等待删除" },
                { "action": "assert", "check": "lambda e: '重命名类别' not in e.annotation_interface.categories", "message": "重命名类别应已删除" },
                { "action": "delete_category", "category_name": "测试类别B", "description": "删除类别B" },
                { "action": "wait", "duration": 300, "description": "等待删除" },
                { "action": "assert", "check": "lambda e: '测试类别B' not in e.annotation_interface.categories", "message": "类别B应已删除" }
            ],
            "on_complete": { "action": "print_result", "message": "类别管理测试完成" }
        },
        {
            "name": "04-工具切换",
            "description": "测试所有标注工具切换",
            "enabled": false,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 1500, "description": "等待项目加载" },
                { "action": "toggle_tool", "tool": "rect", "description": "切换矩形工具" },
                { "action": "wait", "duration": 300, "description": "等待切换" },
                { "action": "toggle_tool", "tool": "polygon", "description": "切换多边形工具" },
                { "action": "wait", "duration": 300, "description": "等待切换" },
                { "action": "toggle_tool", "tool": "sam", "description": "切换SAM工具" },
                { "action": "wait", "duration": 300, "description": "等待切换" },
                { "action": "toggle_tool", "tool": "ai_rect", "description": "切换AI矩形工具" },
                { "action": "wait", "duration": 300, "description": "等待切换" },
                { "action": "toggle_tool", "tool": "obb", "description": "切换旋转框工具" },
                { "action": "wait", "duration": 300, "description": "等待切换" },
                { "action": "toggle_tool", "tool": "edit", "description": "切换编辑工具" },
                { "action": "wait", "duration": 300, "description": "等待切换" },
                { "action": "toggle_tool", "tool": "roi", "description": "切换ROI工具" },
                { "action": "wait", "duration": 300, "description": "等待切换" }
            ],
            "on_complete": { "action": "print_result", "message": "工具切换测试完成" }
        },
        {
            "name": "05-任务模式与导出格式",
            "description": "测试检测/分割/旋转框模式切换和导出格式切换（set_export_format 已移除，导出格式由 version 插件管理，场景停用）",
            "enabled": false,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 1500, "description": "等待项目加载" },
                { "action": "set_task_mode", "mode": "det", "description": "切换到检测模式" },
                { "action": "wait", "duration": 500, "description": "等待模式切换" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.draw_area.task_mode == 'det'", "message": "任务模式应为det" },
                { "action": "set_export_format", "format": "yolo", "description": "设置YOLO格式" },
                { "action": "wait", "duration": 300, "description": "等待格式切换" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.export_format_combo.currentText() == 'yolo'", "message": "导出格式应为yolo" },
                { "action": "set_export_format", "format": "coco", "description": "设置COCO格式" },
                { "action": "wait", "duration": 300, "description": "等待格式切换" },
                { "action": "set_export_format", "format": "voc", "description": "设置VOC格式" },
                { "action": "wait", "duration": 300, "description": "等待格式切换" },
                { "action": "set_task_mode", "mode": "seg", "description": "切换到分割模式" },
                { "action": "wait", "duration": 500, "description": "等待模式切换" },
                { "action": "set_export_format", "format": "yoloseg", "description": "设置YOLO分割格式" },
                { "action": "wait", "duration": 300, "description": "等待格式切换" },
                { "action": "set_export_format", "format": "labelme", "description": "设置LabelMe格式" },
                { "action": "wait", "duration": 300, "description": "等待格式切换" },
                { "action": "set_task_mode", "mode": "obb", "description": "切换到旋转框模式" },
                { "action": "wait", "duration": 500, "description": "等待模式切换" },
                { "action": "set_export_format", "format": "yoloobb", "description": "设置YOLO旋转框格式" },
                { "action": "wait", "duration": 300, "description": "等待格式切换" },
                { "action": "set_task_mode", "mode": "seg", "description": "恢复分割模式" },
                { "action": "wait", "duration": 500, "description": "等待模式切换" }
            ],
            "on_complete": { "action": "print_result", "message": "任务模式与导出格式测试完成" }
        },
        {
            "name": "06-显示选项与筛选",
            "description": "测试显示选项、类别筛选、尺寸筛选",
            "enabled": false,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 1500, "description": "等待项目加载" },
                { "action": "set_display_options", "show_bbox": false, "description": "隐藏边界框" },
                { "action": "wait", "duration": 200, "description": "等待显示更新" },
                { "action": "assert", "check": "lambda e: not e.annotation_interface.cb_show_bbox.isChecked()", "message": "边界框应已隐藏" },
                { "action": "set_display_options", "show_bbox": true, "show_label": false, "description": "显示边界框，隐藏标签" },
                { "action": "wait", "duration": 200, "description": "等待显示更新" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.cb_show_bbox.isChecked() and not e.annotation_interface.cb_show_label.isChecked()", "message": "bbox应显示，标签应隐藏" },
                { "action": "set_display_options", "show_label": true, "description": "恢复显示标签" },
                { "action": "wait", "duration": 200, "description": "等待显示更新" },
                { "action": "set_filter", "mode": "category", "category": "object", "description": "设置类别筛选" },
                { "action": "wait", "duration": 300, "description": "等待筛选" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.filter_category == 'object'", "message": "筛选类别应为object" },
                { "action": "clear_filters", "target": "category", "description": "清除类别筛选" },
                { "action": "wait", "duration": 200, "description": "等待清除" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.filter_category is None", "message": "类别筛选应已清除" },
                { "action": "set_filter", "mode": "preset", "index": 1, "description": "设置尺寸筛选-小" },
                { "action": "wait", "duration": 300, "description": "等待筛选" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.filter_size_range is not None", "message": "尺寸筛选应已设置" },
                { "action": "clear_filters", "target": "size", "description": "清除尺寸筛选" },
                { "action": "wait", "duration": 200, "description": "等待清除" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.filter_size_range is None", "message": "尺寸筛选应已清除" }
            ],
            "on_complete": { "action": "print_result", "message": "显示选项与筛选测试完成" }
        },
        {
            "name": "07-标注操作",
            "description": "测试保存、撤销、重做、清除标注",
            "enabled": false,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 1500, "description": "等待项目加载" },
                { "action": "select_image", "image_index": 0, "description": "选择第一张图片" },
                { "action": "wait", "duration": 500, "description": "等待图片加载" },
                { "action": "save_current", "silent": true, "description": "保存当前标注(静默)" },
                { "action": "wait", "duration": 300, "description": "等待保存" },
                { "action": "step_history", "direction": -1, "description": "撤销" },
                { "action": "wait", "duration": 200, "description": "等待撤销" },
                { "action": "step_history", "direction": 1, "description": "重做" },
                { "action": "wait", "duration": 200, "description": "等待重做" },
                { "action": "clear_annotations", "skip_confirm": true, "description": "清除所有标注(跳过确认)" },
                { "action": "wait", "duration": 300, "description": "等待清除" },
                { "action": "step_history", "direction": -1, "description": "撤销清除" },
                { "action": "wait", "duration": 200, "description": "等待撤销" }
            ],
            "on_complete": { "action": "print_result", "message": "标注操作测试完成" }
        },
        {
            "name": "08-数据集分割与视图",
            "description": "测试数据集分割选择、视图重置",
            "enabled": false,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 1500, "description": "等待项目加载" },
                { "action": "set_split", "split": "train", "description": "设置为训练集" },
                { "action": "wait", "duration": 200, "description": "等待切换" },
                { "action": "set_split", "split": "val", "description": "设置为验证集" },
                { "action": "wait", "duration": 200, "description": "等待切换" },
                { "action": "set_split", "split": "test", "description": "设置为测试集" },
                { "action": "wait", "duration": 200, "description": "等待切换" },
                { "action": "set_split", "split": "train", "description": "恢复训练集" },
                { "action": "wait", "duration": 200, "description": "等待切换" },
                { "action": "reset_view", "description": "重置视图" },
                { "action": "wait", "duration": 200, "description": "等待重置" }
            ],
            "on_complete": { "action": "print_result", "message": "数据集分割与视图测试完成" }
        },
        {
            "name": "09-自动标注模型设置",
            "description": "测试自动标注模型和交互式模型切换",
            "enabled": false,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 1500, "description": "等待项目加载" },
                { "action": "set_model", "role": "auto", "model_name": "sam3", "description": "设置自动标注模型为sam3" },
                { "action": "wait", "duration": 300, "description": "等待模型切换" },
                { "action": "set_model", "role": "interactive", "model_name": "mobilesam_onnx", "description": "设置交互式模型为mobilesam_onnx" },
                { "action": "wait", "duration": 300, "description": "等待模型切换" }
            ],
            "on_complete": { "action": "print_result", "message": "自动标注模型设置测试完成" }
        },
        {
            "name": "10-文件操作",
            "description": "测试文件右键菜单操作（复制路径、打开位置）",
            "enabled": false,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 1500, "description": "等待项目加载" },
                { "action": "select_image", "image_index": 0, "description": "选择第一张图片" },
                { "action": "wait", "duration": 500, "description": "等待图片加载" },
                { "action": "copy_file_path", "description": "复制文件路径" },
                { "action": "wait", "duration": 200, "description": "等待操作" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.current_image_path is not None", "message": "当前图片路径应存在" },
                { "action": "open_in_explorer", "target": "file", "description": "打开文件位置" },
                { "action": "wait", "duration": 500, "description": "等待操作" }
            ],
            "on_complete": { "action": "print_result", "message": "文件操作测试完成" }
        },
        {
            "name": "11-副标注",
            "description": "测试加载副标注、清除副标注",
            "enabled": false,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 1500, "description": "等待项目加载" },
                { "action": "load_secondary_annotations", "directory": "", "description": "加载副标注(无指定目录则跳过)" },
                { "action": "wait", "duration": 500, "description": "等待加载" },
                { "action": "clear_secondary_annotations", "clear_dir": false, "description": "清除当前副标注" },
                { "action": "wait", "duration": 300, "description": "等待清除" }
            ],
            "on_complete": { "action": "print_result", "message": "副标注测试完成" }
        },
        {
            "name": "12-ROI与持久化",
            "description": "测试清除持久化ROI",
            "enabled": false,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 1500, "description": "等待项目加载" },
                { "action": "clear_persistent_roi", "description": "清除持久化ROI" },
                { "action": "wait", "duration": 200, "description": "等待清除" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.draw_area.persistent_roi is None", "message": "持久化ROI应已清除" }
            ],
            "on_complete": { "action": "print_result", "message": "ROI与持久化测试完成" }
        },
        {
            "name": "13-工具栏按钮切换",
            "description": "点击竖排工具栏的每个工具按钮，观察切换效果",
            "enabled": true,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 2000, "description": "等待项目加载" },
                { "action": "select_image", "image_index": 0, "description": "选择第一张图片" },
                { "action": "wait", "duration": 1000, "description": "等待图片加载" },
                { "action": "toggle_tool", "tool": "rect", "description": "点击矩形标注按钮" },
                { "action": "wait", "duration": 2000, "description": "观察矩形工具激活（按钮高亮）" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.draw_area.mode == 1", "message": "应为矩形模式(RECT=1)" },
                { "action": "toggle_tool", "tool": "sam", "description": "点击AI点工具按钮" },
                { "action": "wait", "duration": 2000, "description": "观察点工具激活" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.draw_area.mode == 3", "message": "应为SAM模式(SAM=3)" },
                { "action": "toggle_tool", "tool": "ai_rect", "description": "点击AI矩形框按钮" },
                { "action": "wait", "duration": 2000, "description": "观察AI矩形框激活" },
                { "action": "toggle_tool", "tool": "poly", "description": "点击多边形标注按钮" },
                { "action": "wait", "duration": 2000, "description": "观察多边形工具激活" },
                { "action": "toggle_tool", "tool": "obb", "description": "点击旋转检测按钮" },
                { "action": "wait", "duration": 2000, "description": "观察旋转框工具激活" },
                { "action": "toggle_tool", "tool": "edit", "description": "点击编辑模式按钮" },
                { "action": "wait", "duration": 2000, "description": "观察编辑模式激活" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.draw_area.mode == 0", "message": "应为编辑模式(EDIT=0)" },
                { "action": "toggle_tool", "tool": "roi", "description": "点击ROI区域按钮" },
                { "action": "wait", "duration": 2000, "description": "观察ROI工具激活" },
                { "action": "toggle_tool", "tool": "edit", "description": "切回编辑模式" },
                { "action": "wait", "duration": 1000, "description": "等待切换" }
            ],
            "on_complete": { "action": "print_result", "message": "工具栏按钮切换测试完成" }
        },
        {
            "name": "14-SAM打点标注+右键确认",
            "description": "用SAM工具打点标注，右键确认，观察完整标注流程",
            "enabled": true,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 2000, "description": "等待项目加载" },
                { "action": "select_image", "image_index": 0, "description": "选择第一张图片" },
                { "action": "wait", "duration": 1000, "description": "等待图片加载" },
                { "action": "toggle_tool", "tool": "sam", "description": "切换到SAM点工具" },
                { "action": "wait", "duration": 1500, "description": "等待工具切换" },
                { "action": "input.mouse", "op": "click", "x": 250, "y": 250, "button": "left", "widget_name": "DrawingWidget", "description": "左键点击添加正样本点" },
                { "action": "wait", "duration": 4000, "description": "等待SAM推理完成，观察分割预览" },
                { "action": "input.mouse", "op": "click", "x": 250, "y": 250, "button": "right", "widget_name": "DrawingWidget", "description": "右键确认SAM标注" },
                { "action": "wait", "duration": 3000, "description": "观察标注确认并添加到列表" },
                { "action": "assert", "check": "lambda e: len(e.annotation_interface.draw_area.annotations) > 0", "message": "SAM标注应已添加" },
                { "action": "key_shortcut", "shortcut": "Escape", "description": "退出SAM模式" },
                { "action": "wait", "duration": 500, "description": "等待退出" }
            ],
            "on_complete": { "action": "print_result", "message": "SAM打点标注测试完成" }
        },
        {
            "name": "15-矩形拖拽+旋转框+右键菜单",
            "description": "用矩形工具拖拽画框，旋转框工具，编辑模式右键菜单",
            "enabled": true,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 4000, "description": "等待项目加载" },
                { "action": "select_image", "image_index": 0, "description": "选择第一张图片" },
                { "action": "wait", "duration": 2000, "description": "等待图片加载" },
                { "action": "draw_rect", "x": 100, "y": 100, "w": 200, "h": 150, "label": "object", "description": "先画一个矩形标注" },
                { "action": "wait", "duration": 3000, "description": "观察矩形标注" },
                { "action": "assert", "check": "lambda e: len(e.annotation_interface.draw_area.annotations) > 0", "message": "矩形标注应已添加" },
                { "action": "toggle_tool", "tool": "rect", "description": "切换矩形标注工具" },
                { "action": "wait", "duration": 2000, "description": "等待工具激活" },
                { "action": "input.mouse", "op": "drag", "x1": 80, "y1": 80, "x2": 300, "y2": 250, "widget_name": "DrawingWidget", "description": "拖拽画矩形框" },
                { "action": "wait", "duration": 5000, "description": "观察矩形标注结果" },
                { "action": "toggle_tool", "tool": "edit", "description": "切换编辑模式" },
                { "action": "wait", "duration": 2000, "description": "等待编辑模式" },
                { "action": "input.mouse", "op": "move", "x": 200, "y": 180, "widget_name": "DrawingWidget", "description": "移动鼠标到标注上方" },
                { "action": "wait", "duration": 1000, "description": "等待hover状态更新" },
                { "action": "input.mouse", "op": "click", "x": 200, "y": 180, "button": "right", "widget_name": "DrawingWidget", "description": "右键弹出上下文菜单" },
                { "action": "wait", "duration": 10000, "description": "观察右键菜单（10秒）" },
                { "action": "key_shortcut", "shortcut": "Escape", "description": "关闭右键菜单" },
                { "action": "wait", "duration": 1000, "description": "等待关闭" },
                { "action": "clear_annotations", "skip_confirm": true, "description": "清除所有标注" },
                { "action": "wait", "duration": 1000, "description": "等待清除" }
            ],
            "on_complete": { "action": "print_result", "message": "矩形拖拽+右键菜单测试完成" }
        },
        {
            "name": "16-多标注Tab切换+列表聚焦+V键",
            "description": "创建多个标注，Tab切换，列表点击聚焦，V键缩放",
            "enabled": true,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 4000, "description": "等待项目加载" },
                { "action": "select_image", "image_index": 0, "description": "选择第一张图片" },
                { "action": "wait", "duration": 2000, "description": "等待图片加载" },
                { "action": "draw_rect", "x": 30, "y": 30, "w": 100, "h": 80, "label": "object", "description": "画矩形框1(左上)" },
                { "action": "wait", "duration": 3000, "description": "观察矩形1" },
                { "action": "draw_rect", "x": 250, "y": 200, "w": 120, "h": 90, "label": "object", "description": "画矩形框2(右下)" },
                { "action": "wait", "duration": 3000, "description": "观察矩形2" },
                { "action": "draw_rect", "x": 150, "y": 100, "w": 80, "h": 60, "label": "object", "description": "画矩形框3(中间)" },
                { "action": "wait", "duration": 3000, "description": "观察矩形3" },
                { "action": "toggle_tool", "tool": "edit", "description": "切换到编辑模式" },
                { "action": "wait", "duration": 2000, "description": "等待编辑模式" },
                { "action": "select_annotation", "direction": 1, "description": "Tab切换到下一个标注" },
                { "action": "wait", "duration": 4000, "description": "观察标注1被选中并聚焦" },
                { "action": "assert", "check": "lambda e: len(e.annotation_interface.draw_area.annotations) == 0 or e.annotation_interface.draw_area.selected_index >= 0", "message": "应选中一个标注" },
                { "action": "select_annotation", "direction": 1, "description": "Tab切换到下一个标注" },
                { "action": "wait", "duration": 4000, "description": "观察标注2被选中并聚焦" },
                { "action": "select_annotation", "direction": 1, "description": "Tab切换到下一个标注" },
                { "action": "wait", "duration": 4000, "description": "观察标注3被选中并聚焦" },
                { "action": "toggle_view", "description": "V键聚焦当前标注缩放" },
                { "action": "wait", "duration": 4000, "description": "观察V键缩放到标注区域" },
                { "action": "toggle_view", "description": "V键恢复视图" },
                { "action": "wait", "duration": 3000, "description": "观察视图恢复" },
                { "action": "clear_annotations", "skip_confirm": true, "description": "清除所有标注" },
                { "action": "wait", "duration": 1000, "description": "等待清除" }
            ],
            "on_complete": { "action": "print_result", "message": "Tab切换+聚焦+V键测试完成" }
        },
        {
            "name": "17-画布缩放与拖动",
            "description": "测试画布放大缩小、中键拖动平移",
            "enabled": true,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 4000, "description": "等待项目加载" },
                { "action": "select_image", "image_index": 0, "description": "选择第一张图片" },
                { "action": "wait", "duration": 2000, "description": "等待图片加载" },
                { "action": "zoom", "direction": 1, "description": "放大画布" },
                { "action": "wait", "duration": 4000, "description": "观察放大效果" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.draw_area.pixmap is not None and e.annotation_interface.draw_area.zoom > 0.5", "message": "缩放值应大于0.5" },
                { "action": "zoom", "direction": 1, "description": "继续放大" },
                { "action": "wait", "duration": 4000, "description": "观察放大效果" },
                { "action": "input.mouse", "op": "drag", "x1": 400, "y1": 200, "x2": 200, "y2": 200, "button": "middle", "widget_name": "DrawingWidget", "description": "中键拖动平移画布(向左)" },
                { "action": "wait", "duration": 6000, "description": "观察画布向左平移" },
                { "action": "input.mouse", "op": "drag", "x1": 200, "y1": 200, "x2": 400, "y2": 200, "button": "middle", "widget_name": "DrawingWidget", "description": "中键拖动反向平移(向右)" },
                { "action": "wait", "duration": 6000, "description": "观察画布向右平移" },
                { "action": "zoom", "direction": -1, "description": "缩小画布" },
                { "action": "wait", "duration": 4000, "description": "观察缩小效果" },
                { "action": "zoom", "direction": -1, "description": "继续缩小" },
                { "action": "wait", "duration": 4000, "description": "观察缩小效果" },
                { "action": "reset_view", "description": "适应画布" },
                { "action": "wait", "duration": 4000, "description": "观察适应效果" },
                { "action": "reset_view", "description": "重置视图" },
                { "action": "wait", "duration": 4000, "description": "观察重置效果" }
            ],
            "on_complete": { "action": "print_result", "message": "画布缩放与拖动测试完成" }
        },
        {
            "name": "18-ROI选择与V键缩放",
            "description": "用ROI工具画区域，V键缩放到ROI区域",
            "enabled": true,
            "steps": [
                { "action": "click_project_card", "project_index": 0, "description": "进入项目" },
                { "action": "wait", "duration": 4000, "description": "等待项目加载" },
                { "action": "select_image", "image_index": 0, "description": "选择第一张图片" },
                { "action": "wait", "duration": 2000, "description": "等待图片加载" },
                { "action": "toggle_tool", "tool": "roi", "description": "切换到ROI工具" },
                { "action": "wait", "duration": 2000, "description": "等待ROI工具激活" },
                { "action": "input.mouse", "op": "drag", "x1": 100, "y1": 100, "x2": 350, "y2": 350, "widget_name": "DrawingWidget", "description": "拖拽画ROI区域" },
                { "action": "wait", "duration": 5000, "description": "观察ROI区域选择效果" },
                { "action": "toggle_view", "description": "V键缩放到ROI区域" },
                { "action": "wait", "duration": 5000, "description": "观察V键缩放到ROI区域" },
                { "action": "toggle_view", "description": "V键恢复视图" },
                { "action": "wait", "duration": 3000, "description": "观察视图恢复" },
                { "action": "clear_persistent_roi", "description": "清除ROI" },
                { "action": "wait", "duration": 2000, "description": "等待清除" },
                { "action": "assert", "check": "lambda e: e.annotation_interface.draw_area.persistent_roi is None", "message": "ROI应已清除" }
            ],
            "on_complete": { "action": "print_result", "message": "ROI与V键缩放测试完成" }
        }
    ],
    "settings": {
        "default_wait_after_action": 200,
        "fail_on_error": false,
        "log_level": "info",
        "auto_close_on_complete": true
    }
}
