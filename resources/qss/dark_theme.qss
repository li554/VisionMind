/* ============================================================================
   1. 基础与全局样式
   ============================================================================ */
QWidget {
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
}

/* 主窗口背景 - VSCode 风格深色 */
#MainWindowCentral, #NavigationBar, #CustomStatusBar {
    background-color: #181818 !important;
}

#stackedWidget, #stackedWidget > QWidget {
    background-color: #1a1a1a !important;
}

/* 侧边栏与状态栏边框 */
#CustomStatusBar { border-top: 1px solid #2a2a2a; }

/* 标题栏下方与导航栏右侧的分隔线 */
#TitleBarSeparator, #NavBarSeparator {
    color: #2a2a2a;
    background-color: #2a2a2a;
    border: none;
}

/* ============================================================================
   2. 界面通用背景 (#1a1a1a)
   ============================================================================ */
/* 所有一级界面、滚动区域背景、以及特定容器 */
#DashboardInterface, #VersionInterface, #AnnotationInterface, #AutoAnnotationInterface,
#GenerationInterface, #TrainingInterface, #InferenceInterface, #KachiInterface, #UnsupervisedTrainingInterface, #FlowInterface,
.Interface, .DashboardInterface, .VersionInterface, .AnnotationInterface,
.AutoAnnotationInterface, .GenerationInterface, .TrainingInterface,
.InferenceInterface, .KachiInterface, .UnsupervisedTrainingInterface, .FlowInterface,
QScrollArea, QScrollArea > QWidget, QScrollArea #qt_scrollarea_viewport,
#DashboardScroll, #VersionSettingsScroll, #AnnotationCanvasContainer, #KachiResultLabel {
    background-color: #1a1a1a !important;
}

/* ============================================================================
   3. 透明化规则 (消除多余色块)
   ============================================================================ */
/* 滚动区域内部容器、列表、以及各种功能容器 */
SingleDirectionScrollArea, ScrollArea, #DashboardScroll, #VersionScroll, #maskScroll, 
#VersionSettingsScroll, #VersionHistoryList, ListWidget,
QScrollArea > QWidget > QWidget, SingleDirectionScrollArea > QWidget > QWidget, 
ScrollArea > QWidget > QWidget,
#projectContainer, #versionContainer, #VersionSettingsGroup, #ExampleContainer,
#refContainer, #resultContainer, #datasetContainer, #configContainer, #actionContainer, 
#emptyContainer, #supportPathGroup, #anchorContainer, #maskContainer, #anchorScroll, 
#maskScroll, #refScroll, #configScroll, #resultScroll,
#AnnotationToolbarContent, #AutoAnnotationToolbarContent,
#GenerationResultScroll, #TrainingConfigScroll, #TrainingConfigContainer {
    background-color: transparent !important;
    border: none;
    outline: none;
}

/* 滚动条 */
QScrollArea VScrollBar {
    background-color: transparent;
    width: 8px;
}

/* ============================================================================
   4. 通用组件 (卡片、按钮、输入框)
   ============================================================================ */
/* 卡片 - 使用纯色背景避免圆角透明问题 */
SimpleCardWidget, CardWidget, #VersionStatsCard, #ExampleCard, #AugmentationCard,
SolidCardWidget, SimpleSolidCardWidget {
    background-color: #252525;
    border: 2px solid #252525;
    border-radius: 8px;
}
SimpleCardWidget:hover, CardWidget:hover,
SolidCardWidget:hover, SimpleSolidCardWidget:hover {
    background-color: #2d2d2d;
    border: 2px solid #3b82f6;
}

/* GlobalSettingsCard 和 ProjectSettingsCard 内部容器背景色 */
#GlobalSettingsScrollArea, #GlobalSettingsContainer,
#ProjectSettingsScrollArea, #ProjectSettingsContainer,
#Step2ScrollArea, #Step2Content {
    background-color: transparent;
    border: none;
}

/* 流程配置界面卡片 - 直角样式 */
#FlowToolBoxCard, #FlowGraphCard, #FlowPropertyCard, #FlowStatusCard {
    border-radius: 0px;
}

/* 流程配置界面结果预览标签 */
#FlowResultDisplayLabel {
    background-color: #1e1e1e;
    border: 1px solid #3d3d3d;
    border-radius: 4px;
    color: #9ca3af;
}

/* 节点属性面板 */
#NodePropertyPanel {
    background-color: #1e1e1e;
    border: 1px solid #3d3d3d;
    border-radius: 4px;
}

#NodePropertyPanel #FlowPropertyEmptyLabel {
    color: #6b7280;
}

/* 标签文字 */
StrongBodyLabel { color: #e5e7eb; font-weight: 600; }
SubtitleLabel, .InterfaceTitle, .ProjectTitle { color: #ffffff; font-weight: bold; }
CaptionLabel, .ProjectSubtitle, .VersionInfoLabel, #AnnotationIndexLabel, 
#AnnotationDirLabel, .VersionStatTitle, #TrainingMetricsLabel { color: #9ca3af; }

/* 按钮 */
PrimaryPushButton { background-color: #2563eb; color: #ffffff; border-radius: 8px; }
PrimaryPushButton:hover { background-color: #3b82f6; }
PushButton {
    background-color: rgba(255, 255, 255, 0.1);
    color: #e5e7eb;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
}
PushButton:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid #3b82f6;
}

/* 图标按钮（ToolButton）：默认纯透明无边框，仅悬浮/按下/选中时显示背景 */
ToolButton {
    background-color: transparent;
    color: #e5e7eb;
    border: none;
    border-radius: 6px;
    padding: 2px;
}
ToolButton:hover { background-color: rgba(255, 255, 255, 0.09); }
ToolButton:pressed { background-color: rgba(255, 255, 255, 0.16); }
ToolButton:checked { background-color: rgba(0, 122, 255, 0.18); color: #4da2ff; }
ToolButton:disabled { color: rgba(255, 255, 255, 0.3); }

/* 输入框 */
TextEdit, LineEdit, ComboBox, SpinBox, DoubleSpinBox {
    background-color: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e5e7eb;
    border-radius: 8px;
    padding: 4px 8px;
}
TextEdit:focus, LineEdit:focus, ComboBox:focus, SpinBox:focus, DoubleSpinBox:focus {
    border: 1px solid #2563eb;
    background-color: rgba(0, 0, 0, 0.3);
}

/* ============================================================================
   5. 业务特定组件
   ============================================================================ */
/* 标注工具栏 */
#AnnotationToolbar, #AutoAnnotationToolbar, #AutoAnnotationModeToolbar {
    background: #2b2b2b;
    border: none;
}
#AnnotationToolbar { max-height: 32px; }
#AnnotationModeToolbar {
    background: rgba(43, 43, 43, 0.90);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
}

/* 标注菜单栏 */
#AnnotationMenuBar {
    background: #2b2b2b;
    border-bottom: none;
    padding: 4px 4px 0px 4px;
    font-size: 13px;
    max-height: 32px;
}
#AnnotationMenuBar::item {
    padding: 2px 8px;
    border-radius: 4px;
    color: #cccccc;
}
#AnnotationMenuBar::item:selected, #AnnotationMenuBar::item:pressed {
    background: #3d3d3d;
    color: #ffffff;
}
#AnnotationMenuBar QMenu {
    background: #2b2b2b;
    border: 1px solid #444;
    border-radius: 6px;
    padding: 4px 0px;
}
#AnnotationMenuBar QMenu::item {
    padding: 4px 24px;
    color: #cccccc;
    border-radius: 4px;
    margin: 1px 4px;
}
#AnnotationMenuBar QMenu::item:selected {
    background: #3d3d3d;
    color: #ffffff;
}
#AnnotationMenuBar QMenu::separator {
    height: 1px;
    background: #444;
    margin: 4px 8px;
}

/* 录制指示器 */
#RecordingIndicator {
    color: #ff4444;
    font-weight: bold;
    font-size: 12px;
    padding: 0 8px;
}

/* 侧边栏面板（与画布区域同色，接缝无过渡） */
#AnnotationSidebar, #AnnotationRightSidebar, #AutoAnnotationSidebar {
    background: #1a1a1a;
    border: none;
}
/* 1px 边界线由面板自身边框绘制（画在面板贴画布一侧） */
#AnnotationSidebar { border-right: 1px solid #333; }
#AnnotationRightSidebar { border-left: 1px solid #333; }
/* 标注界面分割条：手柄透明，1px 边界线改由面板自身边框绘制（恒为细线） */
#AnnotationSplitter::handle {
    background: transparent;
}

/* 启动界面 */
#SplashScreenContainer { background-color: #202020; border-radius: 15px; border: 1px solid #333; }
#SplashScreenStatus { color: #AAAAAA; }
#SplashScreenCopyright { color: #555555; }
#SplashScreenTitle { color: white; }

/* Agent 侧栏接缝（与标注面板边界线同款） */
#AgentSidebarSeparator {
    background-color: #333;
    border: none;
}

/* 对话框 */
QDialog { background-color: #1a1a1a; border: 1px solid #333; }
QDialog QListWidget, QDialog ListWidget {
    background-color: #202020;
    border: 1px solid #333;
    color: #e5e7eb;
}
QDialog QCheckBox { color: #e5e7eb; }

/* 控制台与日志 */
#InferenceLogList, #TrainingLogConsole {
    background-color: #111111;
    border: 1px solid #333;
    color: #d4d4d4;
    font-family: 'Consolas', 'Courier New', monospace;
}

/* 加载遮罩 */
#loadingMask { background-color: rgba(0, 0, 0, 180); border-radius: 12px; }
.LoadingTip { color: white; font-weight: bold; font-size: 16px; }

/* 其他细节样式 */
ImageLabel {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}
Slider { height: 20px; }
.AugmentationSelectInfo { color: #3b82f6; font-weight: 500; }
.VersionStatValue { font-size: 22px; font-weight: bold; }
.VersionStatValue[statColor="#3b82f6"] { color: #3b82f6; }
.VersionStatValue[statColor="#10b981"] { color: #10b981; }
.VersionStatValue[statColor="#f59e0b"] { color: #f59e0b; }
.ToolbarLabel { color: #ffffff; font-weight: bold; font-size: 11px; opacity: 0.9; }
.IterStatLabel { color: #E81123; }

/* ============================================================================
   6. 智能调参界面 (SmartParameterDialog)
   ============================================================================ */
SmartParameterDialog {
    background-color: #1a1a1a;
    color: #ffffff;
}

SmartParameterDialog QGroupBox {
    border: 1px solid #444444;
    border-radius: 8px;
    margin-top: 15px;
    padding-top: 15px;
    font-weight: bold;
    background-color: #242424;
}

SmartParameterDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 15px;
    padding: 0 5px;
    color: #00d1ff;
}

SmartParameterDialog CaptionLabel, SmartParameterDialog QLabel, SmartParameterDialog StrongBodyLabel {
    color: #ffffff;
}


SmartParameterDialog DoubleSpinBox, SmartParameterDialog SpinBox, SmartParameterDialog LineEdit {
    background-color: #333333;
    border: 1px solid #555555;
    color: #ffffff;
}

/* ============================================================================
   7. VS Code 风格设置界面
   ============================================================================ */
#ConfigInterface {
    background-color: #1a1a1a;
}

/* 搜索栏 */
#SearchBar {
    background-color: #1a1a1a;
    border-bottom: 1px solid #333;
}
/* 覆盖 qfw SearchLineEdit 的主题色下划线 */
#SearchBar SearchLineEdit {
    background: transparent;
    border: none;
    border-bottom: 1px solid #333;
    border-radius: 0;
}
#SearchBar SearchLineEdit:hover {
    border-bottom: 1px solid #4b5563;
}
#SearchBar SearchLineEdit:focus {
    border-bottom: 1px solid #2563eb;
}

/* 分类树 */
#SettingsCategoryTree {
    background-color: #1a1a1a;
    border-right: 1px solid #333;
}

#CategoryTreeScroll {
    background-color: transparent;
    border: none;
}
/* 滚动区 viewport 默认用浅色调色板自填充，强制透明以融入暗色面板 */
#CategoryTreeScroll > QWidget, #CategoryTreeScroll > QWidget > QWidget {
    background-color: transparent;
}
#GroupContainer {
    background-color: transparent;
}

/* 页头 */
#PageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #ffffff;
}
#PageDesc {
    color: #9ca3af;
    font-size: 13px;
}

/* 设置分组卡片 */
#SectionCard {
    background-color: #1f1f1f;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
}
#SectionCard #SectionHeader {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

/* 设置项行 */
#SettingItem {
    background-color: transparent;
}
#SettingItem:hover {
    background-color: rgba(255, 255, 255, 0.02);
}
#SettingTitle {
    color: #e5e7eb;
    font-size: 13px;
    font-weight: 600;
}

/* 分组标题 */
#GroupHeader {
    background-color: transparent;
}

#GroupHeader:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

#GroupArrow {
    color: #9ca3af;
    font-size: 10px;
}

#GroupTitle {
    color: #9ca3af;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
}

/* 分类按钮 */
#CategoryButton {
    background-color: transparent;
    border-left: 2px solid transparent;
}

#CategoryButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

#CategoryButton[selected="true"] {
    background-color: rgba(255, 255, 255, 0.08);
    border-left-color: #2563eb;
}

#CategoryButtonTitle {
    color: #e5e7eb;
    font-size: 13px;
}

#CategoryButton[selected="true"] #CategoryButtonTitle {
    color: #ffffff;
    font-weight: 500;
}

/* 分隔线 */
#CategorySeparator {
    background-color: #333;
    border: none;
    width: 1px;
}

/* 内容区域 */
#SettingsStacked {
    background-color: #1a1a1a;
}

#SettingsContentPage {
    background-color: transparent;
    border: none;
}

/* 设置项 */
#SettingItem {
    background-color: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

#SettingItem:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

#SettingTitle {
    color: #e5e7eb;
    font-size: 14px;
    font-weight: 400;
}

#SettingDescription {
    color: #9ca3af;
    font-size: 12px;
    margin-top: 0;
    line-height: 1.4;
}

/* 分组标题 */
#SectionHeader {
    background-color: transparent;
}

#SectionHeader:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

#CollapseArrow {
    color: #9ca3af;
    font-size: 10px;
}

#SectionTitle {
    color: #e5e7eb;
    font-size: 16px;
    font-weight: 600;
}

/* 分隔线 */
#SettingSeparator {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    max-height: 1px;
    margin: 0;
}

/* ============================================================================
   8. 无边框窗口 & 导航栏
   ============================================================================ */
#MainWindowCentral {
    background-color: #181818;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
}

#NavigationBar {
    background-color: #181818;
}

#NavButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #9ca3af;
    padding: 8px;
}

#NavButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #e5e7eb;
}

#NavButton:checked {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-weight: 500;
}

#CustomTitleBar {
    background-color: #181818;
}

#DragArea {
    background-color: transparent;
}

#TitleBarAppName {
    color: #cccccc;
    font-size: 13px;
    font-weight: 500;
    padding: 0;
}

#GlobalMenuBar {
    background-color: transparent;
    color: #e5e7eb;
    spacing: 0px;
    border: none;
    padding-top: 4px;
}

#GlobalMenuBar::item {
    padding: 7px 12px;
    border-radius: 4px;
    color: #cccccc;
}

#GlobalMenuBar::item:selected, #GlobalMenuBar::item:pressed {
    background: #3d3d3d;
    color: #ffffff;
}

#GlobalMenuBar QMenu {
    background: #2b2b2b;
    border: 1px solid #444;
    border-radius: 6px;
    padding: 4px 0px;
}

#GlobalMenuBar QMenu::item {
    padding: 5px 24px;
    color: #cccccc;
    border-radius: 4px;
    margin: 1px 4px;
}

#GlobalMenuBar QMenu::item:selected {
    background: #3d3d3d;
    color: #ffffff;
}

#GlobalMenuBar QMenu::separator {
    height: 1px;
    background: #444;
    margin: 4px 8px;
}

#WindowBtn_minimize, #WindowBtn_maximize {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    color: #cccccc;
    min-width: 46px;
    max-width: 46px;
    min-height: 32px;
    max-height: 32px;
}

#WindowBtn_minimize:hover, #WindowBtn_maximize:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

#WindowBtn_close {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    color: #cccccc;
    min-width: 46px;
    max-width: 46px;
    min-height: 32px;
    max-height: 32px;
}

#WindowBtn_close:hover {
    background-color: #e81123;
    color: white;
}

#CustomStatusBar {
    background-color: #181818;
    border-top: 1px solid #3c3c3c;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    color: #9ca3af;
    font-size: 12px;
}

