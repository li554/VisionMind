[
  {
    "key": "theme",
    "title": "主题模式",
    "type": "combo",
    "options": [
      "暗色主题",
      "亮色主题"
    ],
    "default": "dark",
    "value": "dark",
    "description": "控制应用程序的主题风格。暗色主题适合长时间使用，亮色主题更适合白天环境。切换后立即生效。"
  },
  {
    "key": "outputs_root",
    "title": "项目根目录",
    "type": "string",
    "default": "",
    "value": "",
    "description": "项目输出的根目录路径。所有项目的标注结果、版本数据等都会存储在此目录下。留空则使用默认的 outputs 目录。"
  },
  {
    "key": "example_model",
    "title": "示例模型",
    "type": "combo",
    "options": [
      "trtsam3",
      "sam3",
      "sam3_radio",
      "yoloe-26x"
    ],
    "default": "sam3",
    "value": "sam3",
    "description": "选择用于自动标注的AI模型。trtsam3是TensorRT加速版本，速度最快；sam3是标准版本；sam3_radio支持文本引导；yoloe-26x是YOLO系列轻量模型。"
  },
  {
    "key": "example_img_size",
    "title": "示例推理尺寸",
    "type": "int",
    "min": 64,
    "max": 2048,
    "default": 640,
    "value": 644,
    "description": "自动标注时输入图像的尺寸（像素）。较大的尺寸可以检测更小的缺陷，但会增加推理时间和显存占用。建议根据显卡性能选择512-1024之间的值。"
  },
  {
    "key": "high_precision",
    "title": "高精度",
    "type": "combo",
    "options": [
      "打开",
      "关闭"
    ],
    "default": "关闭",
    "value": "关闭",
    "description": "启用高精度模式会使用更精确的后处理算法，可以减少误检和漏检，但会显著降低推理速度。适用于对精度要求高的场景。"
  },
  {
    "key": "mask_smooth_enabled",
    "title": "掩码平滑",
    "type": "combo",
    "options": [
      "打开",
      "关闭"
    ],
    "default": "打开",
    "value": "打开",
    "description": "启用掩码平滑可以优化AI分割结果的边缘，使标注边界更加平滑自然。关闭后保持原始分割边缘，适合需要精确像素级标注的场景。"
  },
  {
    "key": "mask_smooth_epsilon",
    "title": "掩码平滑系数",
    "type": "float",
    "min": 0.0001,
    "max": 0.01,
    "default": 0.001,
    "value": 0.001,
    "description": "控制掩码边缘的平滑程度。值越小边缘越平滑，值越大边缘越贴近原始分割。范围0.0001-0.01，推荐值0.001。"
  },
  {
    "key": "refine_method",
    "title": "细化模型",
    "type": "combo",
    "options": [
      "vitmatte",
      "cascadepsp"
    ],
    "default": "vitmatte",
    "value": "vitmatte",
    "description": "选择用于边缘细化的模型。vitmatte基于Transformer，效果更精细；cascadepsp为级联PSP模型，速度快且显存占用低。"
  },
  {
    "key": "refine_use_onnx",
    "title": "细化模型ONNX加速",
    "type": "combo",
    "options": [
      "打开",
      "关闭"
    ],
    "default": "打开",
    "value": "打开",
    "description": "启用ONNX推理加速（仅ViTMatte模型生效）。开启后显著提升推理速度，需确保模型目录下存在ONNX格式模型文件。"
  },
  {
    "key": "refine_fast",
    "title": "CascadePSP快速模式",
    "type": "combo",
    "options": [
      "关闭",
      "打开"
    ],
    "default": "关闭",
    "value": "关闭",
    "description": "CascadePSP快速模式仅执行全局细化步骤，跳过多尺度局部细化。速度更快但精度略低，适用于实时标注场景。"
  },
  {
    "key": "refine_image_size",
    "title": "细化图像处理尺寸",
    "type": "int",
    "min": 32,
    "max": 2048,
    "default": 896,
    "value": 896,
    "description": "细化模型处理图像时的最大边长。较大的值保留更多细节但占用更多显存。ViTMatte推荐896，CascadePSP推荐320。"
  },
  {
    "key": "refine_trimap_thickness",
    "title": "Trimap区域厚度",
    "type": "int",
    "min": 1,
    "max": 100,
    "default": 20,
    "value": 20,
    "description": "ViTMatte模型的Trimap灰色过渡区域厚度（像素）。该区域是模型重点优化的边界区域，值越大细化范围越广，但计算量也相应增加。"
  },
  {
    "key": "refine_use_roi",
    "title": "细化ROI局部优化",
    "type": "combo",
    "options": [
      "打开",
      "关闭"
    ],
    "default": "打开",
    "value": "打开",
    "description": "启用后仅对标注区域及其周边进行细化，大幅减少显存占用和处理时间，特别适合大尺寸图像。关闭则对全图进行细化。"
  },
  {
    "key": "refine_roi_margin",
    "title": "ROI扩展比例",
    "type": "float",
    "min": 0.01,
    "max": 1.0,
    "default": 0.15,
    "value": 0.15,
    "description": "ROI区域向外扩展的比例。较大的值为边界提供更多上下文信息，细化效果更好，但处理区域增大。推荐0.1-0.3之间。"
  },
  {
    "key": "slice_inference_enabled",
    "title": "启用切片推理",
    "type": "combo",
    "options": [
      "打开",
      "关闭"
    ],
    "default": "关闭",
    "value": "关闭",
    "description": "启用切片推理可以处理超大尺寸图像。系统会将图像分割成多个小块分别推理，然后合并结果。适用于高分辨率工业检测场景。"
  },
  {
    "key": "slice_rows",
    "title": "切片行数",
    "type": "int",
    "min": 1,
    "max": 4,
    "default": 2,
    "value": 2,
    "description": "将图像在垂直方向分割的块数。例如设置为2表示将图像分为上下两块。增加切片数可以处理更大的图像，但会增加处理时间。"
  },
  {
    "key": "slice_cols",
    "title": "切片列数",
    "type": "int",
    "min": 1,
    "max": 4,
    "default": 2,
    "value": 2,
    "description": "将图像在水平方向分割的块数。例如设置为2表示将图像分为左右两块。与切片行数配合使用，总切片数=行数×列数。"
  },
  {
    "key": "slice_overlap_ratio",
    "title": "切片重叠比例",
    "type": "float",
    "min": 0,
    "max": 1,
    "default": 0.2,
    "value": 0.2,
    "description": "相邻切片之间的重叠比例。重叠区域可以避免边缘漏检，但会增加计算量。推荐值0.1-0.3。"
  },
  {
    "key": "slice_postprocess_type",
    "title": "切片后处理算法",
    "type": "combo",
    "options": [
      "GREEDYNMM",
      "NMS",
      "NMM"
    ],
    "default": "GREEDYNMM",
    "value": "GREEDYNMM",
    "description": "选择切片合并时的后处理算法。GREEDYNMM适合大多数场景；NMS是非极大值抑制；NMM是NMS的变体。"
  },
  {
    "key": "slice_match_metric",
    "title": "切片匹配度量",
    "type": "combo",
    "options": [
      "IOS",
      "IOU"
    ],
    "default": "IOS",
    "value": "IOS",
    "description": "用于判断两个检测结果是否匹配的度量标准。IOS是交集除以较小框面积；IOU是交集除以并集面积。"
  },
  {
    "key": "slice_match_threshold",
    "title": "切片匹配阈值",
    "type": "float",
    "min": 0.1,
    "max": 0.9,
    "default": 0.5,
    "value": 0.5,
    "description": "将检测结果判定为匹配的阈值。超过此阈值的两个检测会被合并为一个。值越大匹配越严格。"
  },
